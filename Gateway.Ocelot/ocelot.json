{
  "Routes": [
    {
      "DownstreamPathTemplate": "/authapi/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "authservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "frontendapp",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/app/{everything}",
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/patientapi/patients/add", //AddPatient()
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "medilabo.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/medilabo/patients/add",
      "UpstreamHttpMethod": [ "POST" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer", //protection by Ocelot for logged user
        "AllowedScopes": [ "organizer_access" ] //if IsOrganizer is true
      }
    },
    {
      "DownstreamPathTemplate": "/patientapi/patients/{id}", //UpdatePatient()
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "medilabo.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/medilabo/patients/{id}",
      "UpstreamHttpMethod": [ "PUT" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer", //protection by Ocelot for logged user
        "AllowedScopes": [ "organizer_access" ] //if IsOrganizer is true
      }
    },
    {
      "DownstreamPathTemplate": "/patientapi/patients/{id}", //DeletePatient()
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "medilabo.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/medilabo/patients/{id}",
      "UpstreamHttpMethod": [ "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer", //protection by Ocelot for logged user
        "AllowedScopes": [ "organizer_access" ] //if IsOrganizer is true
      }
    },
    {
      "DownstreamPathTemplate": "/patientapi/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "medilabo.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/medilabo/{everything}",
      "UpstreamHttpMethod": [ "GET" ] //No ["POST", "PUT", "DELETE"] cause it's open for every one
    },
    {
      "DownstreamPathTemplate": "/noteapi/notes/{patientId}/note", //AddNoteToPatient()
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "medinote.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/medinote/notes/{patientId}/note",
      "UpstreamHttpMethod": [ "POST" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer", //protection by Ocelot for logged user
        "AllowedScopes": [] //empty = just a valid token is required
      }
    },
    {
      "DownstreamPathTemplate": "/noteapi/notes/deletenotes/{noteId}", //DeleteNote()
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "medinote.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/medinote/notes/deletenotes/{noteId}",
      "UpstreamHttpMethod": [ "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer", //protection by Ocelot for logged user
        "AllowedScopes": [] //empty = just a valid token is required
      }
    },
    {
      "DownstreamPathTemplate": "/noteapi/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "medinote.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/medinote/{everything}",
      "UpstreamHttpMethod": [ "GET", "PUT" ] //No ["POST", "DELETE"] cause it's open for every one
    },
    {
      "DownstreamPathTemplate": "/riskapi/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "risk.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/riskof/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://gateway.ocelot"
  }
}
